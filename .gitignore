# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
.venv/
venv/

# Generated data (large, machine-produced — do not commit)
data/*.json
logs/*.log
!logs/.gitkeep
logs/

# Generated skills (output artifacts)
generated_skills/

# Runtime state (sync timestamp)
.last_sync_ts

# Editor
.vscode/
.idea/
# R17: OS + editor junk never ships
.DS_Store
._*
# R11-hygiene (B.11 risk 4): the local ledgers carry machine paths
data/install_ledger.json
data/usage_ledger.json
# runtime data dirs wholesale (a clean clone of the pinned commit
# contains none of it)
data/
logs/
generated_skills/
.attic/
installed-skill-archive*
